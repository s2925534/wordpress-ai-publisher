# Copy to .env in this directory. Loaded by docker-compose.web.yml's
# env_file:. Transfer it to your deployment host however your tooling does
# that (scp, your deploy tool of choice, a secrets manager, ...) -- keep it
# readable only by the container user (e.g. chmod 600) since it holds
# secrets. Never commit the real .env -- it's gitignored.

APP_URL=https://app.example.com
APP_ENV=production
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=replace-with-64-char-hex-secret
APP_ENCRYPTION_KEY=replace-with-a-different-64-char-hex-secret
DATABASE_URL=file:/app/data/production.db
CONFIG_DIR=./config
DEFAULT_SITE_KEY=default-site
DEFAULT_CONTENT_PROFILE_KEY=linkedin-blog-package
